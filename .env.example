# rl-crypto example environment.
# Copy to .env before use:  cp .env.example .env
#
# rl-crypto itself is keyless — the core path of both upstreams needs no
# credentials. The variables below are the knobs rl-crypto reads directly;
# upstreams read their own TICKERKIT_* / TNS_* variables (see their READMEs).

# Default news lookback window (hours) for `unified`.
RL_CRYPTO_LOOKBACK_HOURS=3

# Default market history interval for `dataset`.
RL_CRYPTO_TIMEFRAME=1h

# News history bucket for `dataset`: hour | day.
RL_CRYPTO_GRANULARITY=hour

# Default dataset output format: jsonl | csv.
RL_CRYPTO_FORMAT=jsonl

# --- upstream knobs that are useful here --------------------------------------

# tickerkit: where its git-trackable SQLite cache lives.
# TICKERKIT_CACHE_PATH=$PWD/rl_crypto_cache.sqlite3

# ticker-news-signals: cache path + any optional credential.
# TNS_CACHE_PATH=$PWD/ticker_news_signals_cache.sqlite3
# TNS_CRYPTOPANIC_TOKEN=   # optional; lights up CryptoPanic